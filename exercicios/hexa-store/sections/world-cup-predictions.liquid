{% comment %} sections/world-cup-predictions.liquid {% endcomment %}
{{ 'section-world-cup-predictions.css' | asset_url | stylesheet_tag }}

<div class="predictions page-width color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="predictions__container center">
    
    <div class="predictions__header">
      {%- if section.settings.title != blank -%}
        <h2 class="predictions__main-title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <div class="predictions__main-subtitle rte">
          {{ section.settings.subtitle }}
        </div>
      {%- endif -%}
    </div>

    <!-- Arena do Placar Configurável -->
    <div class="predictions__arena">
      <div class="predictions__match-card">
        <div class="predictions__team">
          <span class="predictions__flag">{{ section.settings.team_1_flag }}</span>
          <span class="predictions__team-name">{{ section.settings.team_1_name }}</span>
        </div>
        
        <div class="predictions__vs">VS</div>
        
        <div class="predictions__team">
          <span class="predictions__flag">{{ section.settings.team_2_flag }}</span>
          <span class="predictions__team-name">{{ section.settings.team_2_name }}</span>
        </div>
      </div>

      <div class="predictions__info-match">
        <p><strong>Próximo Confronto:</strong> {{ section.settings.match_date }}</p>
      </div>
    </div>

    <!-- Blocos de Instrução Dinâmicos (Como Participar / Regulamento) -->
    <div class="predictions__steps grid grid--1-col grid--3-col-tablet">
      {%- for block in section.blocks -%}
        <div class="predictions__step-item grid__item" {{ block.shopify_attributes }}>
          <div class="predictions__step-card">
            <div class="predictions__step-icon">{{ forloop.index }}</div>
            {%- if block.settings.step_title != blank -%}
              <h3 class="predictions__step-title h4">{{ block.settings.step_title }}</h3>
            {%- endif -%}
            {%- if block.settings.step_text != blank -%}
              <div class="predictions__step-text rte">
                {{ block.settings.step_text }}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="predictions__actions">
        <a {% if section.settings.button_link == blank %} role="link" aria-disabled="true"{% else %} href="{{ section.settings.button_link }}"{% endif %} 
           class="button button--primary">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Arena de Palpites Copa",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título Principal",
      "default": "Palpite Premiado Copa 2027"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "<p>Acerte o placar final do próximo jogaço da nossa seleção feminina e fature na hora 10% de desconto em toda a loja!</p>"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Pequeno" },
        { "value": "h1", "label": "Médio" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1",
      "label": "Tamanho do Título"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de Cores",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Configuração da Partida"
    },
    {
      "type": "text",
      "id": "team_1_name",
      "label": "Time 1 (Mandante)",
      "default": "Brasil"
    },
    {
      "type": "text",
      "id": "team_1_flag",
      "label": "Emoji da Bandeira 1",
      "default": "🇧🇷"
    },
    {
      "type": "text",
      "id": "team_2_name",
      "label": "Time 2 (Visitante)",
      "default": "França"
    },
    {
      "type": "text",
      "id": "team_2_flag",
      "label": "Emoji da Bandeira 2",
      "default": "🇫🇷"
    },
    {
      "type": "text",
      "id": "match_date",
      "label": "Data e Horário do Jogo",
      "default": "Fase de Grupos - Em breve"
    },
    {
      "type": "header",
      "content": "Botão de Ação"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do Botão",
      "default": "Enviar Meu Palpite"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do Formulário de Palpites"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento Superior",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento Inferior",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "rule_step",
      "name": "Regra ou Instrução",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "step_title",
          "label": "Título da Etapa",
          "default": "Como funciona"
        },
        {
          "type": "richtext",
          "id": "step_text",
          "label": "Instruções",
          "default": "<p>Clique no botão e preencha seu placar antes do apito inicial.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Arena de Palpites Copa",
      "blocks": [
        {
          "type": "rule_step",
          "settings": {
            "step_title": "1. Dê o seu Palpite",
            "step_text": "<p>Insira seu nome, e-mail e o palpite exato do jogo no formulário oficial da rodada.</p>"
          }
        },
        {
          "type": "rule_step",
          "settings": {
            "step_title": "2. Torça Bastante",
            "step_text": "<p>Acompanhe a nossa seleção na busca pelo título mundial de 2027!</p>"
          }
        },
        {
          "type": "rule_step",
          "settings": {
            "step_title": "3. Fature o Cupom",
            "step_text": "<p>Se acertar em cheio, um cupom exclusivo de 10% OFF será disparado para seu e-mail de cadastro.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}s