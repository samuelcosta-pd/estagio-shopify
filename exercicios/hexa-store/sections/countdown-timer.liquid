{% comment %} sections/countdown-timer.liquid {% endcomment %}
{{ 'section-countdown-timer.css' | asset_url | stylesheet_tag }}

<div class="countdown-banner section-{{ section.id }}-padding" style="background-color: {{ section.settings.section_background_color }};">
  <div class="countdown-banner__overlay" style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  <div class="countdown-banner__inner page-width color-{{ section.settings.color_scheme }} gradient">
    <div class="countdown-banner__container center">
    
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        
        {%- when 'heading' -%}
          <div class="countdown-banner__header-block" {{ block.shopify_attributes }}>
            <h2
              class="countdown-banner__title inline-richtext {{ block.settings.heading_size }}"
              style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.font_size }}px; font-family: {{ block.settings.font_family }}; text-align: {{ block.settings.text_align }};"
            >
              {{ block.settings.text }}
            </h2>
          </div>

        {%- when 'subheading' -%}
          <div class="countdown-banner__header-block countdown-banner__header-block--subheading" {{ block.shopify_attributes }}>
            <div
              class="countdown-banner__subheading rte"
              style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.font_size }}px; font-family: {{ block.settings.font_family }}; text-align: {{ block.settings.text_align }};"
            >
              {{ block.settings.text }}
            </div>
          </div>

        {%- when 'timer' -%}
          <div class="countdown-banner__timer" 
               id="Countdown-{{ section.id }}" 
               data-date="{{ block.settings.end_date }}"
               {{ block.shopify_attributes }}>
            <div class="countdown-banner__time-box" style="background-color: {{ block.settings.time_box_background_color }}; border-color: {{ block.settings.border_color }};">
              <span class="countdown-banner__number data-days" style="color: {{ block.settings.number_color }};">00</span>
              <span class="countdown-banner__label" style="color: {{ block.settings.label_color }};">Dias</span>
            </div>
            <div class="countdown-banner__time-box" style="background-color: {{ block.settings.time_box_background_color }}; border-color: {{ block.settings.border_color }};">
              <span class="countdown-banner__number data-hours" style="color: {{ block.settings.number_color }};">00</span>
              <span class="countdown-banner__label" style="color: {{ block.settings.label_color }};">Horas</span>
            </div>
            <div class="countdown-banner__time-box" style="background-color: {{ block.settings.time_box_background_color }}; border-color: {{ block.settings.border_color }};">
              <span class="countdown-banner__number data-minutes" style="color: {{ block.settings.number_color }};">00</span>
              <span class="countdown-banner__label" style="color: {{ block.settings.label_color }};">Min</span>
            </div>
            <div class="countdown-banner__time-box" style="background-color: {{ block.settings.time_box_background_color }}; border-color: {{ block.settings.border_color }};">
              <span class="countdown-banner__number data-seconds" style="color: {{ block.settings.number_color }};">00</span>
              <span class="countdown-banner__label" style="color: {{ block.settings.label_color }};">Seg</span>
            </div>
          </div>

        {%- when 'button' -%}
          <div class="countdown-banner__buttons" {{ block.shopify_attributes }}>
            {%- if block.settings.button_label != blank -%}
              <a {% if block.settings.button_link == blank %} role="link" aria-disabled="true"{% else %} href="{{ block.settings.button_link }}"{% endif %} 
                 class="button countdown-banner__button {% if block.settings.button_style_secondary %} button--secondary {% else %} button--primary {% endif %}">
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}

    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const countdownSection = document.querySelector('.countdown-banner');
    const timerContainer = document.getElementById('Countdown-{{ section.id }}');

    if (countdownSection && countdownSection.classList.contains('countdown-banner--has-image-bg')) {
      const bgElement = countdownSection.querySelector('.countdown-banner__background');
      let ticking = false;

      const updateParallax = () => {
        if (!bgElement) return;
        const rect = countdownSection.getBoundingClientRect();
        const screenHeight = window.innerHeight;
        
        // Verifica se a seção está visível no viewport para otimizar desempenho
        if (rect.top < screenHeight && rect.bottom > 0) {
          // Calcula o deslocamento baseado no scroll
          const speed = 0.4; 
          const yPos = -((rect.top) * speed);
          bgElement.style.transform = `translate3d(0, ${yPos}px, 0)`;
        }
        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(updateParallax);
          ticking = true;
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      updateParallax();
    }

    if (!timerContainer) return;

    const endDateString = timerContainer.getAttribute('data-date');
    const countDownDate = new Date(endDateString).getTime();

    if (isNaN(countDownDate)) {
      timerContainer.innerHTML = "<p class='rte'>Configure uma data válida no formato AAAA-MM-DD.</p>";
      return;
    }

    const daysEl = timerContainer.querySelector('.data-days');
    const hoursEl = timerContainer.querySelector('.data-hours');
    const minutesEl = timerContainer.querySelector('.data-minutes');
    const secondsEl = timerContainer.querySelector('.data-seconds');

    const updateTimer = () => {
      const now = new Date().getTime();
      const distance = countDownDate - now;

      if (distance < 0) {
        clearInterval(timerInterval);
        timerContainer.innerHTML = "<h3 class='h4'>A oferta expirou!</h3>";
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      daysEl.textContent = String(days).padStart(2, '0');
      hoursEl.textContent = String(hours).padStart(2, '0');
      minutesEl.textContent = String(minutes).padStart(2, '0');
      secondsEl.textContent = String(seconds).padStart(2, '0');
    };

    updateTimer();
    const timerInterval = setInterval(updateTimer, 1000);
  });
</script>

{% schema %}
{
  "name": "Contagem Rumo a 2027",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
