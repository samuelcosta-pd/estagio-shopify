{% comment %} sections/countdown-timer.liquid {% endcomment %}
{{ 'section-countdown-timer.css' | asset_url | stylesheet_tag }}

<div class="countdown-banner page-width color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="countdown-banner__container center">
    
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        
        {%- when 'heading' -%}
          <h2 class="countdown-banner__title inline-richtext {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </h2>

        {%- when 'subheading' -%}
          <div class="countdown-banner__subheading rte" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>

        {%- when 'timer' -%}
          <div class="countdown-banner__timer" 
               id="Countdown-{{ section.id }}" 
               data-date="{{ block.settings.end_date }}"
               {{ block.shopify_attributes }}>
            <div class="countdown-banner__time-box">
              <span class="countdown-banner__number data-days">00</span>
              <span class="countdown-banner__label">Dias</span>
            </div>
            <div class="countdown-banner__time-box">
              <span class="countdown-banner__number data-hours">00</span>
              <span class="countdown-banner__label">Horas</span>
            </div>
            <div class="countdown-banner__time-box">
              <span class="countdown-banner__number data-minutes">00</span>
              <span class="countdown-banner__label">Min</span>
            </div>
            <div class="countdown-banner__time-box">
              <span class="countdown-banner__number data-seconds">00</span>
              <span class="countdown-banner__label">Seg</span>
            </div>
          </div>

        {%- when 'button' -%}
          <div class="countdown-banner__buttons" {{ block.shopify_attributes }}>
            {%- if block.settings.button_label != blank -%}
              <a {% if block.settings.button_link == blank %} role="link" aria-disabled="true"{% else %} href="{{ block.settings.button_link }}"{% endif %} 
                 class="button {% if block.settings.button_style_secondary %} button--secondary {% else %} button--primary {% endif %}">
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}

  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const timerContainer = document.getElementById('Countdown-{{ section.id }}');
    if (!timerContainer) return;

    const endDateString = timerContainer.getAttribute('data-date');
    const countDownDate = new Date(endDateString).getTime();

    if (isNaN(countDownDate)) {
      timerContainer.innerHTML = "<p class='rte'>Configure uma data válida no formatoAAAA-MM-DD.</p>";
      return;
    }

    const daysEl = timerContainer.querySelector('.data-days');
    const hoursEl = timerContainer.querySelector('.data-hours');
    const minutesEl = timerContainer.querySelector('.data-minutes');
    const secondsEl = timerContainer.querySelector('.data-seconds');

    const updateTimer = () => {
      const now = new Date().getTime();
      const distance = countDownDate - now;

      if (distance < 0) {
        clearInterval(timerInterval);
        timerContainer.innerHTML = "<h3 class='h4'>A oferta expirou!</h3>";
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      daysEl.textContent = String(days).padStart(2, '0');
      hoursEl.textContent = String(hours).padStart(2, '0');
      minutesEl.textContent = String(minutes).padStart(2, '0');
      secondsEl.textContent = String(seconds).padStart(2, '0');
    };

    updateTimer();
    const timerInterval = setInterval(updateTimer, 1000);
  });
</script>

{% schema %}
{
  "name": "Contagem Rumo a 2027",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de Cores",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento Superior",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento Inferior",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Título",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Texto do Título",
          "default": "QUEIMA DE ESTOQUE: RUMO A COPA 2027!"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "Pequeno" },
            { "value": "h1", "label": "Médio" },
            { "value": "h0", "label": "Grande" }
          ],
          "default": "h0",
          "label": "Tamanho do Título"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subtítulo",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Garanta as camisas oficiais da Seleção Feminina com preços de fábrica por tempo limitado!</p>"
        }
      ]
    },
    {
      "type": "timer",
      "name": "Contador Regressivo",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "end_date",
          "label": "Data Final (Formato: AAAA-MM-DD)",
          "default": "2027-07-01",
          "info": "Exemplo: 2027-07-01 para primeiro de julho de 2027."
        }
      ]
    },
    {
      "type": "button",
      "name": "Botão de Ação",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do Botão",
          "default": "Aproveitar Descontos"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link do Botão"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "label": "Usar estilo de botão secundário",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contagem Rumo a 2027",
      "blocks": [
        { "type": "heading" },
        { "type": "subheading" },
        { "type": "timer" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}