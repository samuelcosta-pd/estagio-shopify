{% comment %}
  Snippet: Product Card

  Uso:
  {% render 'product-card', product: product, show_badge: true, image_width: 400 %}

  Parâmetros:
  - product: objeto do produto (obrigatório)
  - show_badge: exibir badge de promoção (opcional, default: true)
  - image_width: largura da imagem (opcional, default: 400)
{% endcomment %}

{%- assign largura = image_width | default: 400 -%}
{%- assign show_badge = show_badge | default: true -%}

<style>
  .product-card{border:1px solid #e6e6e6;border-radius:8px;overflow:hidden;padding:12px;background:#fff;transition:box-shadow .18s ease}
  .product-card:hover{box-shadow:0 6px 18px rgba(0,0,0,.08)}
  /* Fade-in animation when section loads */
  .product-card{opacity:0;transform:translateY(6px);animation:product-card-fade .35s ease forwards}
  /* Ensure all preview images share the same visible height by forcing a square media
      container and letting the image cover it. */
  .product-card__media{position:relative;aspect-ratio:1/1;overflow:hidden}
  .product-card__image{display:block;width:100%;height:100%;border-radius:6px;object-fit:contain;transition:transform .3s ease}
  .product-card__media:hover .product-card__image{transform:scale(1.05)}
  .product-card__content{padding-top:10px}
  .product-card__title{font-size:1.5rem;margin:0 0 6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;line-height:1.2;max-height:1.8rem}
  .product-card__title a{color:#111;text-decoration:none;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .product-card__preco{font-weight:600;color:#111}
  .product-card__preco--original{text-decoration:line-through;color:#8a8a8a;font-weight:400;margin-left:8px;font-size:.95rem}
  .product-card__badge{position:absolute;top:10px;left:10px;background:#ff6b6b;color:#fff;padding:6px 8px;border-radius:4px;font-size:.85rem}
  .product-card__badge--sold{background:#777}
  .product-card__btn{display:inline-block;margin-top:10px;padding:8px 12px;background:#111;color:#fff;border-radius:6px;text-decoration:none}
  .product-card__btn[disabled],.product-card__btn.disabled{background:#bbb;cursor:not-allowed}
  .product-card__actions{display:flex;align-items:center;justify-content:space-between;gap:8px}
  .product-card__swatches{display:flex;gap:8px;margin-top:8px}
  .product-card__swatch{width:16px;height:16px;border-radius:50%;border:1px solid rgba(0,0,0,0.06);cursor:default;display:inline-block}
  .product-card__swatch--label{display:flex;align-items:center;justify-content:center;font-size:10px;color:#333;background:#eee}

  @keyframes product-card-fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
</style>

<div class="product-card">
  <div class="product-card__media">
    {% if show_badge %}
      {% if product.available == false %}
        <span class="product-card__badge product-card__badge--sold">Esgotado</span>
      {% elsif product.compare_at_price and product.compare_at_price > product.price %}
        {% assign desconto = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round %}
        <span class="product-card__badge">-{{ desconto }}%</span>
      {% endif %}
    {% endif %}

    {% if product.featured_image %}
      {% comment %} Normalize image URL to avoid relative /files/... paths that cause 404s {% endcomment %}
      {% assign image_src =  product.featured_image | image_url: width: largura %}
      {% unless image_src contains 'http' or image_src contains '//' %}
        {% if image_src contains '/files/' %}
          {% assign image_src = shop.secure_url | append: image_src %}
        {% endif %}
      {% endunless %}

      <a href="{{ product.url }}">
        <img
          src="{{ image_src }}"
          alt="{{ product.title | escape }}"
          class="product-card__image"
          width="{{ largura }}" height="{{ largura }}" />
      </a>
    {% else %}
      {% capture placeholder_svg %}
        <svg xmlns='http://www.w3.org/2000/svg' width='{{ largura }}' height='{{ largura }}' viewBox='0 0 {{ largura }} {{ largura }}'>
          <rect width='100%' height='100%' fill='#efefef' />
          <text x='50%' y='50%' dominant-baseline='middle' text-anchor='middle' fill='#aaa' font-family='Arial, Helvetica, sans-serif' font-size='{{ largura | divided_by: 10 }}'>Sem imagem</text>
        </svg>
      {% endcapture %}

      <a href="{{ product.url }}">
        <img src="data:image/svg+xml;utf8,{{ placeholder_svg | url_encode }}" alt="{{ product.title | escape }}" class="product-card__image" width="{{ largura }}" height="{{ largura }}" />
      </a>
    {% endif %}
  </div>

  <div class="product-card__content">
    <h3 class="product-card__title"><a href="{{ product.url }}" title="{{ product.title | escape }}">{{ product.title | escape }}</a></h3>

    {%- comment -%} Render color variants as swatches if product has a color option {%- endcomment -%}
    {%- assign color_option = nil -%}
    {%- assign color_option_position = 0 -%}
    {%- for opt in product.options_with_values -%}
      {%- assign name_down = opt.name | downcase -%}
      {%- if name_down contains 'color' or name_down contains 'cor' -%}
        {%- assign color_option = opt -%}
        {%- assign color_option_position = forloop.index -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {% if color_option and color_option.values.size > 0 %}
      <div class="product-card__swatches" aria-hidden="true">
        {% for v in color_option.values limit:6 %}
          {% assign v_trim = v | strip %}

          {%- comment -%} Find a variant that matches this color value to link directly to it {% endcomment -%}
          {%- assign variant_id = nil -%}
          {%- assign variant_available = true -%}
          {%- for var in product.variants -%}
            {%- assign match = false -%}
            {%- if color_option_position == 1 and var.option1 == v_trim -%}
              {%- assign match = true -%}
            {%- elsif color_option_position == 2 and var.option2 == v_trim -%}
              {%- assign match = true -%}
            {%- elsif color_option_position == 3 and var.option3 == v_trim -%}
              {%- assign match = true -%}
            {%- endif -%}
            {%- if match -%}
              {%- assign variant_id = var.id -%}
              {%- assign variant_available = var.available -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} If value looks like a hex code, use it directly; otherwise try as color name {% endcomment -%}
          {% if v_trim contains '#' %}
            {% assign swatch_color = v_trim %}
          {% else %}
            {% assign swatch_color = v_trim | downcase %}
          {% endif %}

          {% if variant_id %}
            <a href="{{ product.url }}?variant={{ variant_id }}" class="product-card__swatch-link" title="{{ v_trim | escape }}" aria-label="{{ v_trim | escape }}">
              <span class="product-card__swatch{% unless variant_available %} product-card__swatch--sold{% endunless %}" style="background-color: {{ swatch_color }}"></span>
            </a>
          {% else %}
            <span class="product-card__swatch" title="{{ v_trim | escape }}" style="background-color: {{ swatch_color }}"></span>
          {% endif %}

        {% endfor %}
      </div>
    {% endif %}

    <div class="product-card__actions">
      <div>
        <span class="product-card__preco">{{ product.price | money }}</span>
        {% if product.compare_at_price and product.compare_at_price > product.price %}
          <span class="product-card__preco--original">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>

      {% if product.available == false %}
        <button class="product-card__btn disabled" disabled>Indisponível</button>
      {% else %}
        <a href="{{ product.url }}" class="product-card__btn">Adicionar ao carrinho</a>
      {% endif %}
    </div>
  </div>
</div>
 