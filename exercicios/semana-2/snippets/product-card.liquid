{% comment %}
  Snippet: Product Card

  Uso:
  {% render 'product-card', product: product, show_badge: true, image_width: 400 %}

  Parâmetros:
  - product: objeto do produto (obrigatório)
  - show_badge: exibir badge de promoção (opcional, default: true)
  - image_width: largura da imagem (opcional, default: 400)
{% endcomment %}

{%- assign largura = image_width | default: 400 -%}
{%- assign show_badge = show_badge | default: true -%}

<style>
  .product-card{border:1px solid #e6e6e6;border-radius:8px;overflow:hidden;padding:12px;background:#fff;transition:box-shadow .18s ease}
  .product-card:hover{box-shadow:0 6px 18px rgba(0,0,0,.08)}
    /* Ensure all preview images share the same visible height by forcing a square media
      container and letting the image cover it. */
    .product-card__media{position:relative;aspect-ratio:1/1;overflow:hidden}
    .product-card__image{display:block;width:100%;height:100%;border-radius:6px;object-fit:cover}
  .product-card__content{padding-top:10px}
  .product-card__title{font-size:1rem;margin:0 0 6px}
  .product-card__title a{color:#111;text-decoration:none}
  .product-card__preco{font-weight:600;color:#111}
  .product-card__preco--original{text-decoration:line-through;color:#8a8a8a;font-weight:400;margin-left:8px;font-size:.95rem}
  .product-card__badge{position:absolute;top:10px;left:10px;background:#ff6b6b;color:#fff;padding:6px 8px;border-radius:4px;font-size:.85rem}
  .product-card__badge--sold{background:#777}
  .product-card__media{position:relative}
  .product-card__btn{display:inline-block;margin-top:10px;padding:8px 12px;background:#111;color:#fff;border-radius:6px;text-decoration:none}
  .product-card__btn[disabled],.product-card__btn.disabled{background:#bbb;cursor:not-allowed}
  .product-card__actions{display:flex;align-items:center;justify-content:space-between;gap:8px}
</style>

<div class="product-card">
  <div class="product-card__media">
    {% if show_badge %}
      {% if product.available == false %}
        <span class="product-card__badge product-card__badge--sold">Esgotado</span>
      {% elsif product.compare_at_price and product.compare_at_price > product.price %}
        {% assign desconto = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round %}
        <span class="product-card__badge">-{{ desconto }}%</span>
      {% endif %}
    {% endif %}

    {% if product.featured_image %}
      {% comment %} Normalize image URL to avoid relative /files/... paths that cause 404s {% endcomment %}
      {% assign image_src =  product.featured_image | image_url: width: largura %}
      {% unless image_src contains 'http' or image_src contains '//' %}
        {% if image_src contains '/files/' %}
          {% assign image_src = shop.secure_url | append: image_src %}
        {% endif %}
      {% endunless %}

      <a href="{{ product.url }}">
        <img
          src="{{ image_src }}"
          alt="{{ product.title | escape }}"
          class="product-card__image"
          width="{{ largura }}" height="{{ largura }}" />
      </a>
    {% else %}
      {% capture placeholder_svg %}
        <svg xmlns='http://www.w3.org/2000/svg' width='{{ largura }}' height='{{ largura }}' viewBox='0 0 {{ largura }} {{ largura }}'>
          <rect width='100%' height='100%' fill='#efefef' />
          <text x='50%' y='50%' dominant-baseline='middle' text-anchor='middle' fill='#aaa' font-family='Arial, Helvetica, sans-serif' font-size='{{ largura | divided_by: 10 }}'>Sem imagem</text>
        </svg>
      {% endcapture %}

      <a href="{{ product.url }}">
        <img src="data:image/svg+xml;utf8,{{ placeholder_svg | url_encode }}" alt="{{ product.title | escape }}" class="product-card__image" width="{{ largura }}" height="{{ largura }}" />
      </a>
    {% endif %}
  </div>

  <div class="product-card__content">
    <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>

    <div class="product-card__actions">
      <div>
        <span class="product-card__preco">{{ product.price | money }}</span>
        {% if product.compare_at_price and product.compare_at_price > product.price %}
          <span class="product-card__preco--original">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>

      {% if product.available == false %}
        <button class="product-card__btn disabled" disabled>Indisponível</button>
      {% else %}
        <a href="{{ product.url }}" class="product-card__btn">Adicionar ao carrinho</a>
      {% endif %}
    </div>
  </div>
</div>
 