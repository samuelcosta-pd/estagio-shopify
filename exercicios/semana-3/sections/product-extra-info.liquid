{% schema %}
{
  "name": "Informações Extras",
  "settings": [
    {
      "type": "text",
      "id": "titulo",
      "label": "Título da seção",
      "default": "Informações do Produto"
    }
  ],
  "presets": [
    {
      "name": "Informações Extras",
      "category": "product"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}

{% if product %}
  {% assign material = product.metafields.custom.material.value %}
  {% assign cuidados = product.metafields.custom.instrucoes_cuidado.value %}
  {% assign video = product.metafields.custom.video_url.value %}
{% endif %}

{% assign editor_preview = false %}
{% if request.design_mode and material == blank and cuidados == blank and video == blank %}
  {% assign editor_preview = true %}
{% endif %}

{% if material != blank or cuidados != blank or video != blank or editor_preview %}

<section class="product-extra-info page-width">
  <div class="product-extra-info__wrapper">

    <h2 class="product-extra-info__title">
      {{ section.settings.titulo }}
    </h2>

    {% if editor_preview %}
      <p class="product-extra-info__hint">
        Preencha os metafields "material", "instrucoes_cuidado" e/ou "video_url"
        do produto para exibir o conteúdo real aqui. Esta é apenas uma prévia.
      </p>
    {% endif %}

    {%- comment -%} material {%- endcomment -%}
    {% if material != blank or editor_preview %}
      <div class="product-extra-info__card">
        <div class="product-extra-info__row">
          <span class="product-extra-info__icon">🧵</span>
          <div>
            <strong>Material</strong>
            <p>{{ material | default: "Ex.: 100% algodão" }}</p>
          </div>
        </div>
      </div>
    {% endif %}

    {%- comment -%} instrucoes de cuidado {%- endcomment -%}
    {% if cuidados != blank or editor_preview %}
      <details class="product-extra-info__accordion">
        <summary>
          🧼 Instruções de cuidado
        </summary>

        <div class="product-extra-info__content">
          {% if cuidados != blank %}
            {{ cuidados | metafield_tag }}
          {% else %}
            <p>Ex.: Lavar à mão, não usar alvejante.</p>
          {% endif %}
        </div>
      </details>
    {% endif %}

    {%- comment -%} video {%- endcomment -%}
    {% if video != blank %}

      {% assign embed_url = video
        | replace: "https://www.youtube.com/watch?v=", "https://www.youtube.com/embed/"
        | replace: "https://youtu.be/", "https://www.youtube.com/embed/"
        | replace: "https://vimeo.com/", "https://player.vimeo.com/video/"
      %}

      <div class="product-extra-info__video">
        <iframe
          src="{{ embed_url }}"
          title="Vídeo do produto"
          loading="lazy"
          allowfullscreen
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
        </iframe>
      </div>

    {% elsif editor_preview %}
      <div class="product-extra-info__video product-extra-info__video--empty">
        <p>🎬 Nenhum vídeo cadastrado no metafield "video_url".</p>
      </div>
    {% endif %}

  </div>
</section>

{% endif %}

<style>
.product-extra-info{
  margin-top:48px;
}

.product-extra-info__wrapper{
  border:1px solid rgba(0,0,0,.08);
  border-radius:12px;
  padding:24px;
  background:#fff;
}

.product-extra-info__title{
  margin:0 0 24px;
}

.product-extra-info__hint{
  margin:-8px 0 20px;
  padding:10px 14px;
  background:#fff8e1;
  border:1px solid #f0d98c;
  border-radius:8px;
  font-size:13px;
  color:#6b5900;
}

.product-extra-info__card{
  padding:16px;
  border:1px solid rgba(0,0,0,.08);
  border-radius:10px;
  margin-bottom:18px;
}

.product-extra-info__row{
  display:flex;
  gap:14px;
  align-items:flex-start;
}

.product-extra-info__icon{
  font-size:24px;
  line-height:1;
}

.product-extra-info__row p{
  margin:4px 0 0;
}

.product-extra-info__accordion{
  border:1px solid rgba(0,0,0,.08);
  border-radius:10px;
  margin-bottom:24px;
  overflow:hidden;
}

.product-extra-info__accordion summary{
  cursor:pointer;
  padding:16px;
  font-weight:600;
  list-style:none;
}

.product-extra-info__accordion summary::-webkit-details-marker{
  display:none;
}

.product-extra-info__content{
  padding:0 16px 16px;
}

.product-extra-info__video{
  position:relative;
  padding-bottom:56.25%;
  height:0;
  overflow:hidden;
  border-radius:12px;
}

.product-extra-info__video iframe{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
}

.product-extra-info__video--empty{
  position:static;
  height:auto;
  padding:24px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#f4f4f4;
  color:#666;
}
</style>