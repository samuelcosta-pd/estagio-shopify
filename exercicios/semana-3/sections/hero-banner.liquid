{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "imagem_fundo",
      "label": "Imagem de fundo"
    },
    {
      "type": "color",
      "id": "cor_overlay",
      "label": "Cor do overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "opacidade_overlay",
      "label": "Opacidade do overlay",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "altura_minima",
      "label": "Altura mínima",
      "min": 300,
      "max": 800,
      "step": 50,
      "default": 500,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "alinhamento",
      "label": "Alinhamento do conteúdo",
      "options": [
        {
          "value": "left",
          "label": "Esquerda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Direita"
        }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    // TODO: Implemente os 4 tipos de blocks aqui
    // heading, paragraph, button, image
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "paragraph"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}