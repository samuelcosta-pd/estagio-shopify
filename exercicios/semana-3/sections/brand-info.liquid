{%- comment -%} sections/brand-info.liquid {%- endcomment -%}
{%- assign marca = product.metafields.custom.marca.value -%}
{%- if marca -%}

<section class="brand-info page-width">
  <div class="brand-info__wrapper">

    <h2 class="brand-info__titulo">{{ section.settings.titulo }}</h2>

    <div class="brand-info__card">

      {%- comment -%} coluna esquerda: logo + nome + origem {%- endcomment -%}
      <div class="brand-info__esquerda">
        {%- if marca.logo -%}
          <div class="brand-info__logo-box">
            <img
              class="brand-info__logo"
              src="{{ marca.logo | image_url: width: 200 }}"
              srcset="{{ marca.logo | image_url: width: 200 }} 1x, {{ marca.logo | image_url: width: 400 }} 2x"
              alt="{{ marca.logo.alt | default: marca.nome | escape }}"
              loading="lazy"
              width="120"
              height="120"
            >
          </div>
        {%- endif -%}
        {%- if marca.nome -%}
          <h3 class="brand-info__nome">{{ marca.nome }}</h3>
        {%- endif -%}
        {%- if marca.pais_origem -%}
          <p class="brand-info__origem">Origem: {{ marca.pais_origem }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} coluna direita: descrição + link {%- endcomment -%}
      {%- if marca.descricao or marca.site -%}
        <div class="brand-info__detalhes">
          {%- if marca.descricao -%}
            <h4 class="brand-info__descricao-titulo">Descrição</h4>
            <p class="brand-info__descricao">{{ marca.descricao }}</p>
          {%- endif -%}
          {%- if marca.site -%}
            <a
              href="{{ marca.site }}"
              target="_blank"
              rel="noopener noreferrer"
              class="brand-info__link"
            >
              Visitar site da marca →
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>

  </div>
</section>

<style>
.brand-info{
  margin-top:48px;
}

.brand-info__wrapper{
  border:1px solid rgba(0,0,0,.08);
  border-radius:12px;
  padding:24px;
  background:#fff;
}

.brand-info__titulo{
  margin:0 0 24px;
}

.brand-info__card{
  display:grid;
  grid-template-columns:auto 1fr;
  gap:32px;
  align-items:stretch;
}

.brand-info__esquerda{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:0.5rem;
  text-align:center;
}

.brand-info__logo-box{
  width:120px;
  height:120px;
  display:flex;
  align-items:center;
  justify-content:center;
  border:1px solid rgba(0,0,0,.15);
  border-radius:16px;
  overflow:hidden;
  background:#fff;
}

.brand-info__logo{
  width:100%;
  height:100%;
  object-fit:contain;
  padding:12px;
  box-sizing:border-box;
}

.brand-info__nome{
  font-size:1.5rem;
  font-weight:600;
  margin:0.25rem 0 0;
}

.brand-info__origem{
  font-size:1rem;
  color:#666;
  margin:0;
}

.brand-info__detalhes{
  display:flex;
  flex-direction:column;
  gap:0.75rem;
  padding-left:32px;
  border-left:1px solid rgba(0,0,0,.1);
}

.brand-info__descricao-titulo{
  font-size:1.8rem;
  font-weight:600;
  margin:0;
  color: dimgray;
}

.brand-info__descricao{
  font-size:1.4rem;
  line-height:1.6;
  color:#333;
  margin:0;
}

.brand-info__link{
  display:inline-block;
  margin-top:auto;
  padding-top:0.5rem;
  font-weight:600;
  text-decoration:none;
  color:#1a1a1a;
}

.brand-info__link:hover{
  text-decoration:underline;
}

@media screen and (max-width:599px){
  .brand-info__card{
    grid-template-columns:1fr;
    justify-items:center;
    text-align:center;
  }

  .brand-info__detalhes{
    border-left:none;
    border-top:1px solid rgba(0,0,0,.1);
    padding-left:0;
    padding-top:24px;
    width:100%;
  }
}
</style>
{%- endif -%}

{% schema %}
{
  "name": "Sobre a Marca",
  "settings": [
    {
      "type": "text",
      "id": "titulo",
      "label": "Título da seção",
      "default": "Sobre a Marca"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Sobre a Marca",
      "category": "product"
    }
  ]
}
{% endschema %}